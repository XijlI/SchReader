        "*://tandfonline.com/*",
        "*://*.tandfonline.com/*",
        "*://sagepub.com/*",
        "*://*.sagepub.com/*",
        "*://oup.com/*",
        "*://*.oup.com/*",
        "*://cambridge.org/*",
        "*://*.cambridge.org/*",
        "*://acs.org/*",
        "*://*.acs.org/*",
        "*://rsc.org/*",
        "*://*.rsc.org/*",
        "*://degruyter.com/*",
        "*://*.degruyter.com/*",
        "*://karger.com/*",
        "*://*.karger.com/*",
        "*://thieme-connect.com/*",
        "*://*.thieme-connect.com/*",
        "*://cochranelibrary.com/*",
        "*://*.cochranelibrary.com/*",
        "*://bmj.com/*",
        "*://*.bmj.com/*",
        "*://nejm.org/*",
        "*://*.nejm.org/*",
        "*://jamanetwork.com/*",
        "*://*.jamanetwork.com/*",
        "*://annualreviews.org/*",
        "*://*.annualreviews.org/*",
        "*://pnas.org/*",
        "*://*.pnas.org/*",
        "*://plos.org/*",
        "*://*.plos.org/*",
        "*://frontiersin.org/*",
        "*://*.frontiersin.org/*",
        "*://mdpi.com/*",
        "*://*.mdpi.com/*",
        "*://asm.org/*",
        "*://*.asm.org/*",
        "*://elifesciences.org/*",
        "*://*.elifesciences.org/*",
        "*://peerj.com/*",
        "*://*.peerj.com/*",
        "*://f1000research.com/*",
        "*://*.f1000research.com/*",
        "*://royalsocietypublishing.org/*",
