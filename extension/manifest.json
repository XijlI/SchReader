        "*://hindawi.com/*",
        "*://*.hindawi.com/*",
        "*://jstage.jst.go.jp/*",
        "*://*.jstage.jst.go.jp/*",
        "*://scielo.br/*",
        "*://*.scielo.br/*",
        "*://aps.org/*",
        "*://*.aps.org/*",
        "*://iop.org/*",
        "*://*.iop.org/*",
        "*://aip.org/*",
        "*://*.aip.org/*",
        "*://ieee.org/*",
        "*://*.ieee.org/*",
        "*://acm.org/*",
        "*://*.acm.org/*",
        "*://jstor.org/*",
        "*://*.jstor.org/*",
        "*://biorxiv.org/*",
        "*://*.biorxiv.org/*",
        "*://medrxiv.org/*",
        "*://*.medrxiv.org/*",
        "*://arxiv.org/*",
        "*://*.arxiv.org/*",
        "*://europepmc.org/*",
        "*://*.europepmc.org/*",
        "*://ncbi.nlm.nih.gov/*",
        "*://*.ncbi.nlm.nih.gov/*",
        "*://cnki.net/*",
        "*://*.cnki.net/*",
        "*://wanfangdata.com.cn/*",
        "*://*.wanfangdata.com.cn/*",
        "*://cqvip.com/*",
        "*://*.cqvip.com/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/whitelist.js",
        "src/extractor/util.js",
        "src/extractor/meta.js",
        "src/extractor/blocks.js",
        "src/extractor/refs.js",
        "src/extractor/figures.js",
        "src/extractor/adapters.js",
        "src/extractor/generic.js",
        "src/content.js"
      ]
    }
  ]
}
