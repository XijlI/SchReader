{
  "manifest_version": 3,
  "name": "SchReader — paper reflow reader",
  "version": "0.1.0",
  "description": "Reflow a publisher's article page into a Nature-like reading layout: one text column plus a Sections / Figures / References rail, citation previews and a figure lightbox.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://sciencedirect.com/*",
    "*://*.sciencedirect.com/*",
    "*://cell.com/*",
    "*://*.cell.com/*",
    "*://thelancet.com/*",
    "*://*.thelancet.com/*",
    "*://springer.com/*",
    "*://*.springer.com/*",
    "*://science.org/*",
    "*://*.science.org/*",
    "*://wiley.com/*",
    "*://*.wiley.com/*",
    "*://tandfonline.com/*",
    "*://*.tandfonline.com/*",
    "*://sagepub.com/*",
    "*://*.sagepub.com/*",
    "*://oup.com/*",
    "*://*.oup.com/*",
    "*://cambridge.org/*",
    "*://*.cambridge.org/*",
    "*://acs.org/*",
    "*://*.acs.org/*",
    "*://rsc.org/*",
    "*://*.rsc.org/*",
    "*://degruyter.com/*",
    "*://*.degruyter.com/*",
    "*://karger.com/*",
    "*://*.karger.com/*",
    "*://thieme-connect.com/*",
    "*://*.thieme-connect.com/*",
    "*://cochranelibrary.com/*",
    "*://*.cochranelibrary.com/*",
    "*://bmj.com/*",
    "*://*.bmj.com/*",
    "*://nejm.org/*",
    "*://*.nejm.org/*",
    "*://jamanetwork.com/*",
    "*://*.jamanetwork.com/*",
    "*://annualreviews.org/*",
    "*://*.annualreviews.org/*",
    "*://pnas.org/*",
    "*://*.pnas.org/*",
    "*://plos.org/*",
    "*://*.plos.org/*",
    "*://frontiersin.org/*",
    "*://*.frontiersin.org/*",
    "*://mdpi.com/*",
    "*://*.mdpi.com/*",
    "*://asm.org/*",
    "*://*.asm.org/*",
    "*://elifesciences.org/*",
    "*://*.elifesciences.org/*",
    "*://peerj.com/*",
    "*://*.peerj.com/*",
    "*://f1000research.com/*",
    "*://*.f1000research.com/*",
    "*://royalsocietypublishing.org/*",
    "*://*.royalsocietypublishing.org/*",
    "*://biologists.com/*",
    "*://*.biologists.com/*",
    "*://physiology.org/*",
    "*://*.physiology.org/*",
    "*://hindawi.com/*",
    "*://*.hindawi.com/*",
    "*://jstage.jst.go.jp/*",
    "*://*.jstage.jst.go.jp/*",
    "*://scielo.br/*",
    "*://*.scielo.br/*",
    "*://aps.org/*",
    "*://*.aps.org/*",
    "*://iop.org/*",
    "*://*.iop.org/*",
    "*://aip.org/*",
    "*://*.aip.org/*",
    "*://ieee.org/*",
    "*://*.ieee.org/*",
    "*://acm.org/*",
    "*://*.acm.org/*",
    "*://jstor.org/*",
    "*://*.jstor.org/*",
    "*://biorxiv.org/*",
    "*://*.biorxiv.org/*",
    "*://medrxiv.org/*",
    "*://*.medrxiv.org/*",
    "*://arxiv.org/*",
    "*://*.arxiv.org/*",
    "*://europepmc.org/*",
    "*://*.europepmc.org/*",
    "*://ncbi.nlm.nih.gov/*",
    "*://*.ncbi.nlm.nih.gov/*",
    "*://cnki.net/*",
    "*://*.cnki.net/*",
    "*://wanfangdata.com.cn/*",
    "*://*.wanfangdata.com.cn/*",
    "*://cqvip.com/*",
    "*://*.cqvip.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "SchReader — my library",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://sciencedirect.com/*",
        "*://*.sciencedirect.com/*",
        "*://cell.com/*",
